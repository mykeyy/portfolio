---
import Icon from "./Icon.astro";
import { site } from "../site";

const year = new Date().getFullYear();
---

<footer class="wrap caps">
  <div class="bar">
    <p>© {year} {site.name}</p>
    <!-- Unique visitors: each browser counts once (the script is in Base.astro) -->
    <p class="visitors" title={`Unique visitors to ${site.domain}. Each browser counts once.`}>
      <Icon name="eye" />
      <span class="sr-only">Unique visitors:</span>
      <span data-visitors>—</span>
    </p>
  </div>
</footer>

<style>
  footer { margin-top: var(--block); }

  .bar {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    /* The rule hangs past the column like every other line; the text stays on the column edge */
    margin-inline: calc(-1 * var(--hang));
    padding: 18px var(--hang) clamp(16px, 2vw, 28px);
    border-top: var(--rule);
  }

  .visitors {
    display: flex;
    align-items: center;
    gap: 0.5em;
    font-variant-numeric: tabular-nums;
  }
</style>
