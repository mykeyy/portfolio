---
import { bearing } from "../lib/bearing";
// The top of a section page: the section's name in the display face, as large as the width allows, with a short mono note.
// `rgb` sets the name in a red-green-blue gradient with a matching band under it (Projects only).
interface Props {
  title: string;
  note?: string;
  rgb?: boolean;
}

const { title, note, rgb = false } = Astro.props;
// The longest word sets a ceiling on the size, so it always fits the column (see h1 below)
const pull = bearing(title);
const chars = Math.max(...title.split(/\s+/).map((w) => w.length));
---

<header class:list={["page-head wrap", { rgb }]}>
  <div class="row">
    <h1 class="display" style={`--chars: ${chars}; --pull: ${pull}em`}>{title}</h1>
    {note && <p class="note caps">{note}</p>}
  </div>
  {rgb && <div class="band" aria-hidden="true" />}
</header>

<style>
  .page-head {
    container-type: inline-size;
    padding-top: clamp(40px, 9vw, 150px);
    margin-bottom: clamp(28px, 4vw, 56px);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px 32px;
  }

  h1 {
    /* As large as the width allows, but never wider than the column: every Geist Mono letter is 0.6em less the
       0.035em tracking, so the longest word is --chars x 0.565em */
    font-size: min(clamp(4.5rem, 1.5rem + 11vw, 14rem), 100cqi / (var(--chars) * 0.565));
    /* The first letter's ink sits on the column edge (src/lib/bearing.ts) */
    margin-left: calc(-1 * var(--pull, 0em));
    line-height: 0.84;
  }

  .note { padding-bottom: 0.4em; }

  /* Projects: the owner asked for the word itself in RGB, so the color lives in the letters */
  .rgb h1 {
    background: var(--rgb);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    /* The gradient only paints inside the box, and the tight line height makes the box shorter than Anton's
       letters, which sliced their tops flat. Extra room above and below, cancelled by negative margins, keeps the
       position and lets the whole glyph fill. */
    padding-block: 0.12em 0.06em;
    margin-block: -0.12em -0.06em;
  }

  /* Like every line that spans the column, the band hangs past it by --hang, so it ends where the list's rules end */
  .band {
    margin-inline: calc(-1 * var(--hang));
    height: clamp(6px, 0.7vw, 12px);
    margin-top: clamp(14px, 1.6vw, 24px);
    background: var(--rgb);
  }
</style>
