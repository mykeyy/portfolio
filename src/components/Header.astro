---
// The top bar (brand link and the four-bar menu button) and the menu itself.
// The menu: the four bars stand up on hover; on click, square cells flicker white and blue until they cover the
// screen, then each bar flies out of the icon and grows into a tall panel, one per section. Without JavaScript the
// button is a link to #menu and the panels simply show.
import { getCollection } from "astro:content";
import { plateInk } from "../lib/plate";
import { site } from "../site";

interface Props {
  /** On the cover the brand link is hidden: the name below is the brand */
  cover?: boolean;
}

const { cover = false } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
// Each panel previews its section: on hover it fills with that section's own ground and figure colors (the themes
// in global.css), so the panel you click is already the page you are going to. Each also carries an icon in ASCII.
const sections = [
  { href: "/projects", label: "Projects", ground: "#ffffff", figure: "#0b0b0b", icon: "projects" },
  { href: "/writing", label: "Writing", ground: "#111111", figure: "#e6e6e1", icon: "writing" },
  { href: "/design", label: "Design", ground: "#061ecf", figure: "#ffffff", icon: "design" },
  { href: "/about", label: "About", ground: "#061ecf", figure: "#ffffff", icon: "about" },
];
// Design's panel cycles through the plate colors of the design pieces while hovered: the same idea as the Design
// page, where the whole page takes on each piece's color.
const plates = (await getCollection("designs"))
  .filter((d) => import.meta.env.DEV || !d.data.draft)
  .map((d) => [d.data.plate, plateInk(d.data.plate)]);
const cycle = JSON.stringify([["#061ecf", "#ffffff"], ...plates]);
const current = (href: string) => (path === href || path.startsWith(`${href}/`) ? "page" : undefined);
---

<header class="site-header">
  <div class="wrap bar">
    {!cover && <a href="/" class="brand caps">{site.domain}</a>}
    <a href="#menu" class="menu-btn" role="button" aria-controls="menu" aria-expanded="false" aria-label="Menu" data-menu-btn>
      <i></i><i></i><i></i><i></i>
    </a>
  </div>
</header>

<nav id="menu" class="menu" aria-label="Sections" data-menu>
  <canvas class="cells" aria-hidden="true" data-cells></canvas>
  <ul class="panels">
    {
      sections.map((s) => (
        <li>
          <a
            href={s.href}
            class:list={["panel", s.icon]}
            aria-current={current(s.href)}
            data-panel
            style={`--to-ground: ${s.ground}; --to-figure: ${s.figure}`}
            data-cycle={s.icon === "design" ? cycle : undefined}
          >
            <span class="glyph" aria-hidden="true" data-glyph={s.icon}>
              <pre />
            </span>
            <span class="word">{s.label}</span>
            <span class="over" aria-hidden="true">
              <span class="word">{s.label}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  const menu = document.querySelector<HTMLElement>("[data-menu]")!;
  const btn = document.querySelector<HTMLAnchorElement>("[data-menu-btn]")!;
  const canvas = menu.querySelector<HTMLCanvasElement>("[data-cells]")!;
  const panels = [...menu.querySelectorAll<HTMLElement>("[data-panel]")];
  const bars = [...btn.querySelectorAll<HTMLElement>("i")];
  const calm = matchMedia("(prefers-reduced-motion: reduce)");
  // Phones and portrait tablets get the landscape menu: the icon stays flat and the panels are wide bands
  const flat = matchMedia("(max-width: 759px), (orientation: portrait) and (max-width: 1023px)");
  const stand = () => !flat.matches && btn.classList.add("up");
  let open = false;
  // Every open and every close bumps the run. A step that belongs to an older run stops where it is, so the menu can
  // be turned around at any moment: mid-opening, a click, Space, Esc, or the background sends it straight back
  // from wherever it got to, and the other way round.
  let run = 0;
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
  // How fast an interrupted flight plays itself back home
  const REWIND = -2.6;

  const color = (name: string) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  // Leaving is quicker than arriving and accelerates into the icon
  const EASE_IN = "cubic-bezier(0.55, 0, 0.75, 0)";

  // The cells: an e-ink refresh. A wave of squares spreads out from the menu button; each square flashes the
  // figure color once (the erase) and then settles on the new state: the ground color when covering, the page
  // underneath when clearing. One flash per square, so only the thin wave front is ever white.
  const FLASH = 55;
  let wave = 0;
  // Opening, the wave spreads out from the menu button; closing is the same wave played backwards, clearing from
  // the far corner in toward the button as the panels fly home. A newer wave stops an older one.
  function cells(cover: boolean, duration = 420) {
    const id = ++wave;
    return new Promise<void>((done) => {
      // Everything is drawn in whole device pixels. At 125% or 150% display scaling a cell of, say, 14 CSS px is
      // 17.5 device pixels, and edges that fall between pixels leave faint seams between neighbouring cells. So the
      // canvas is sized in whole device pixels, cells are a multiple of 4 CSS px (whole device pixels at 1, 1.25,
      // 1.5, 1.75 and 2), and each cell is filled from its own rounded left/top edge to its neighbour's.
      const dpr = Math.min(devicePixelRatio || 1, 2);
      const w = innerWidth, h = innerHeight;
      canvas.width = Math.ceil(w * dpr);
      canvas.height = Math.ceil(h * dpr);
      const ctx = canvas.getContext("2d")!;
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      const size = Math.max(16, Math.round(Math.min(w, h) / 26 / 4) * 4);
      const edge = (n: number) => Math.round(n * size * dpr);
      const cols = Math.ceil(w / size), rows = Math.ceil(h / size);
      const spread = duration - FLASH;
      // A cell's turn comes with its distance from the button, with a touch of noise so the front is a slightly
      // ragged edge of squares instead of a clean circle.
      const b = btn.getBoundingClientRect();
      const bx = b.left + b.width / 2, by = b.top + b.height / 2;
      const far = Math.hypot(Math.max(bx, w - bx), Math.max(by, h - by));
      const starts = Float32Array.from({ length: cols * rows }, (_, i) => {
        const d = Math.hypot((i % cols) * size + size / 2 - bx, Math.floor(i / cols) * size + size / 2 - by) / far;
        return ((cover ? d : 1 - d) * 0.9 + Math.random() * 0.1) * spread;
      });
      const ink = color("--ink"), paper = color("--paper");
      const t0 = performance.now();

      const frame = (now: number) => {
        if (id !== wave) return done();
        const t = now - t0;
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        for (let i = 0; i < starts.length; i++) {
          const p = t - starts[i];
          let fill: string | null;
          if (p < 0) fill = cover ? null : ink;
          else if (p < FLASH) fill = paper;
          else fill = cover ? ink : null;
          if (!fill) continue;
          ctx.fillStyle = fill;
          const c = i % cols, r = Math.floor(i / cols);
          ctx.fillRect(edge(c), edge(r), edge(c + 1) - edge(c), edge(r + 1) - edge(r));
        }
        if (t < duration) requestAnimationFrame(frame);
        else done();
      };
      // Draw the first frame now, so there is never a frame between the class change and the first paint
      frame(t0);
    });
  }

  const flights = () => panels.flatMap((p) => p.getAnimations());
  const landed = (anims: Animation[]) => Promise.all(anims.map((a) => a.finished.catch(() => {})));

  // Each panel starts as its bar in the icon and grows into place (or shrinks back), slightly staggered.
  function fly(out: boolean) {
    // Any earlier flight is done with; measure the panels where they really sit
    panels.forEach((p) => p.getAnimations().forEach((a) => a.cancel()));
    const from = bars.map((b) => b.getBoundingClientRect());
    // The bars become the panels, so the icon leaves as they fly out (and returns once they land back in it)
    if (out) btn.classList.add("gone");
    return landed(
      panels.map((panel, i) => {
        const to = panel.getBoundingClientRect();
        const f = from[i];
        const start = `translate(${f.left - to.left}px, ${f.top - to.top}px) scale(${f.width / to.width}, ${f.height / to.height})`;
        const frames = out ? [{ transform: start }, { transform: "none" }] : [{ transform: "none" }, { transform: start }];
        // Out on the firm spring (a hair of overshoot as they land); home faster, accelerating into the icon
        return panel.animate(frames, {
          duration: out ? 560 : 320,
          delay: out ? i * 45 : (panels.length - 1 - i) * 30,
          easing: out ? color("--spring-firm") : EASE_IN,
          fill: "both",
        });
      }),
    );
  }

  // Turn the flights that are under way around, quickly, from wherever each panel is right now
  function rewind() {
    const anims = flights();
    anims.forEach((a) => {
      a.playbackRate = REWIND;
      a.play();
    });
    return landed(anims);
  }

  async function show() {
    if (open) return;
    open = true;
    const id = ++run;
    // A close that is still running gets turned around instead of starting over
    const turning = menu.classList.contains("is-open");
    btn.setAttribute("aria-expanded", "true");
    // The bars stand up while the cells run, so they are upright by the time the panels fly out of them
    stand();
    document.documentElement.classList.add("menu-open");
    menu.classList.add("is-open");

    if (calm.matches) {
      btn.classList.add("gone");
      menu.classList.remove("covering", "clearing");
      menu.classList.add("landed");
    } else if (turning) {
      menu.classList.remove("clearing");
      menu.classList.add("covering", "flying");
      btn.classList.add("gone");
      await Promise.all([cells(true, 220), rewind()]);
      if (id !== run) return;
      panels.forEach((p) => p.getAnimations().forEach((a) => a.cancel()));
      menu.classList.remove("covering", "flying");
      menu.classList.add("landed");
    } else {
      // The panels start flying out while the wave is still finishing, so the refresh and the panels overlap
      menu.classList.add("covering");
      const waveDone = cells(true);
      await sleep(230);
      if (id !== run) return;
      menu.classList.add("flying");
      const panelsOut = fly(true);
      await waveDone;
      if (id !== run) return;
      menu.classList.remove("covering");
      await panelsOut;
      if (id !== run) return;
      menu.classList.remove("flying");
      menu.classList.add("landed");
    }
    // Keyboard users land on the current section's panel; a mouse or touch open leaves nothing highlighted
    if (keyboard) (panels.find((p) => p.getAttribute("aria-current") === "page") ?? panels[0]).focus();
  }

  async function hide() {
    if (!open) return;
    open = false;
    const id = ++run;
    // An opening that has not landed yet gets turned around instead of playing the whole close
    const turning = !menu.classList.contains("landed");
    btn.setAttribute("aria-expanded", "false");
    menu.classList.remove("landed");
    (document.activeElement as HTMLElement | null)?.blur();

    if (!calm.matches) {
      if (turning) {
        // Panels that have not left the icon yet stay hidden; ones in flight stay visible while they rewind
        menu.classList.add("covering");
        if (flights().length) menu.classList.add("clearing");
        await Promise.all([cells(false, 220), rewind()]);
      } else {
        // The opening in reverse: the panels fly home over solid ground first, and only as the last of them lands
        // does the wave start clearing in toward the icon. The page never shows behind full-size panels.
        const home = fly(false);
        await sleep(300);
        if (id !== run) return;
        menu.classList.add("covering", "clearing");
        const waveDone = cells(false, 340);
        await home;
        if (id !== run) return;
        btn.classList.remove("gone");
        await waveDone;
      }
      if (id !== run) return;
    }
    btn.classList.remove("gone");
    canvas.getContext("2d")?.clearRect(0, 0, canvas.width, canvas.height);
    menu.classList.remove("is-open", "covering", "clearing", "flying");
    panels.forEach((p) => p.getAnimations().forEach((a) => a.cancel()));
    document.documentElement.classList.remove("menu-open");
    if (!btn.matches(":hover")) btn.classList.remove("up");
    if (location.hash === "#menu") history.replaceState(history.state, "", location.pathname + location.search);
    btn.focus({ preventScroll: true });
  }

  const toggle = () => (open ? hide() : show());

  // A click with detail 0 came from the keyboard (Enter or Space)
  let keyboard = false;
  btn.addEventListener("click", (e) => {
    e.preventDefault();
    keyboard = e.detail === 0;
    toggle();
  });
  btn.addEventListener("pointerenter", stand);
  btn.addEventListener("pointerleave", () => !open && btn.classList.remove("up"));
  btn.addEventListener("focus", stand);
  btn.addEventListener("blur", () => !open && btn.classList.remove("up"));

  // Opening a section: the next page grows out of the panel that was clicked (see the script in Base.astro)
  panels.forEach((panel) =>
    panel.addEventListener("click", () => {
      const r = panel.getBoundingClientRect();
      try {
        sessionStorage.setItem("from-panel", JSON.stringify({ top: r.top, right: r.right, bottom: r.bottom, left: r.left, t: Date.now() }));
      } catch {}
    }),
  );

  menu.addEventListener("click", (e) => {
    if (!(e.target as Element).closest("[data-panel]")) hide();
  });
  addEventListener("keydown", (e) => {
    if (e.key === "Escape") hide();
    // Space toggles the menu from the button (a link does not do that on its own) and, while the menu is open or
    // opening, sends it back from anywhere except a panel, where Space follows the link
    if (e.key === " " && !e.repeat) {
      const onPanel = (document.activeElement as Element | null)?.closest?.("[data-panel]");
      if (document.activeElement === btn || (open && !onPanel)) {
        e.preventDefault();
        keyboard = document.activeElement === btn;
        toggle();
      }
    }
  });
  document.addEventListener("menu:open", () => show());

  // Fluid between layouts: when the window crosses from tall panels to wide bands (or back) while the menu is open,
  // each panel morphs from where it was to where it now sits instead of jumping. Rects are recorded at the end of
  // every frame that resized, so the change handler, which runs earlier in the next frame, still has the old ones.
  let before = panels.map((p) => p.getBoundingClientRect());
  let pending = 0;
  addEventListener("resize", () => {
    if (!open || pending) return;
    pending = requestAnimationFrame(() => {
      pending = 0;
      before = panels.map((p) => p.getBoundingClientRect());
    });
  });
  flat.addEventListener("change", () => {
    if (!open || calm.matches || !menu.classList.contains("landed")) {
      before = panels.map((p) => p.getBoundingClientRect());
      return;
    }
    panels.forEach((p, i) => {
      p.getAnimations().forEach((a) => a.cancel());
      const to = p.getBoundingClientRect();
      const f = before[i];
      if (!to.width || !to.height || !f.width) return;
      p.animate(
        [
          { transform: `translate(${f.left - to.left}px, ${f.top - to.top}px) scale(${f.width / to.width}, ${f.height / to.height})` },
          { transform: "none" },
        ],
        { duration: 460, delay: i * 25, easing: color("--spring-firm"), fill: "backwards" },
      );
      // The word turns between upright and level, so it fades back in once its panel has its new shape
      p.querySelectorAll(".word, .glyph").forEach((el) =>
        el.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 240, delay: 220 + i * 25, easing: "ease-out", fill: "backwards" }),
      );
    });
    if (flat.matches) btn.classList.remove("up");
  });

  // The panel icons, set in ASCII. Each icon is drawn once into a small canvas; then every character cell of a
  // monospace grid takes a character by how much of it the drawing covers, from a space up to @. Hovering a panel
  // changes the icon's color with the fill.
  const RAMP = " .:-=+*#%@";
  const COLS = 34, ROWS = 20; // a monospace cell is about 0.6 as wide as it is tall, so this grid is near square
  const ICONS: Record<string, { fill: string[]; cut: string[] }> = {
    // A code window: its title bar, and </> inside
    projects: {
      fill: ["M1.5 3.5H22.5V20.5H1.5Z"],
      cut: ["M1.5 7.6H22.5", "M8.6 11L5.6 14.2L8.6 17.4", "M13.4 10.4L10.6 18", "M15.4 11L18.4 14.2L15.4 17.4"],
    },
    // A pen nib with its slit and breather hole
    writing: {
      fill: ["M12 1.5L19 9L16 19.5H8L5 9Z", "M7 20.5H17V23H7Z"],
      cut: ["M12 5.5V12.5", "M10.6 14.4a1.4 1.4 0 1 0 2.8 0a1.4 1.4 0 1 0 -2.8 0"],
    },
    // A ruler and a pencil, crossed
    design: {
      fill: ["M2 16.5L16.5 2L22 7.5L7.5 22Z", "M3 2.5L7 2L21.5 16.5L17.5 20.5L3 6Z"],
      cut: ["M6.5 12L8.8 14.3", "M9.5 9L11 10.5", "M12.5 6L14.8 8.3", "M5 3.5L18.8 17.3"],
    },
    // A face
    about: {
      fill: ["M1.5 12a10.5 10.5 0 1 0 21 0a10.5 10.5 0 1 0 -21 0"],
      cut: ["M7.3 9.5a1.2 1.2 0 1 0 2.4 0a1.2 1.2 0 1 0 -2.4 0", "M14.3 9.5a1.2 1.2 0 1 0 2.4 0a1.2 1.2 0 1 0 -2.4 0", "M7 14.5Q12 19.5 17 14.5"],
    },
  };

  function ascii(icon: { fill: string[]; cut: string[] }) {
    const S = 8; // samples per character cell
    const c = document.createElement("canvas");
    c.width = COLS * S;
    c.height = ROWS * S;
    const x = c.getContext("2d", { willReadFrequently: true })!;
    // Fit the 24-unit drawing to the grid, square on screen (a character cell is 0.6 wide for 1 tall)
    const unit = Math.min(c.width / 24, c.height / 24 / 0.6);
    x.setTransform(unit, 0, 0, unit * 0.6, (c.width - 24 * unit) / 2, (c.height - 24 * unit * 0.6) / 2);
    icon.fill.forEach((d) => x.fill(new Path2D(d)));
    x.globalCompositeOperation = "destination-out";
    x.lineWidth = 1.5;
    x.lineCap = "round";
    icon.cut.forEach((d) => {
      const p = new Path2D(d);
      x.stroke(p);
      if (d.includes("a1.")) x.fill(p);
    });
    const data = x.getImageData(0, 0, c.width, c.height).data;
    let out = "";
    for (let r = 0; r < ROWS; r++) {
      for (let col = 0; col < COLS; col++) {
        let sum = 0;
        for (let yy = 0; yy < S; yy++)
          for (let xx = 0; xx < S; xx++) sum += data[((r * S + yy) * c.width + col * S + xx) * 4 + 3];
        // Barely touched cells stay empty, so the edge is clean instead of a scatter of dots
        const cover = sum / (S * S * 255);
        out += cover < 0.08 ? " " : RAMP[Math.max(1, Math.min(RAMP.length - 1, Math.round(cover * (RAMP.length - 1))))];
      }
      out += "\n";
    }
    return out;
  }

  // The icons are plain text, set once. On hover they only change color with the panel's fill.
  menu.querySelectorAll<HTMLElement>("[data-glyph]").forEach((box) => {
    const icon = ICONS[box.dataset.glyph ?? ""];
    const pre = box.querySelector("pre");
    if (icon && pre) pre.textContent = ascii(icon);
  });

  // Design's panel: while hovered, the fill steps through each design piece's plate color
  menu.querySelectorAll<HTMLElement>("[data-cycle]").forEach((panel) => {
    let colors: [string, string][] = [];
    try {
      colors = JSON.parse(panel.dataset.cycle ?? "[]");
    } catch {}
    if (colors.length < 2) return;
    let timer = 0;
    let i = 0;
    const paint = () => {
      const [ground, figure] = colors[i % colors.length];
      panel.style.setProperty("--to-ground", ground);
      panel.style.setProperty("--to-figure", figure);
    };
    panel.addEventListener("pointerenter", () => {
      if (calm.matches) return;
      clearInterval(timer);
      i = 0;
      timer = window.setInterval(() => {
        i++;
        paint();
      }, 700);
    });
    panel.addEventListener("pointerleave", () => {
      clearInterval(timer);
      i = 0;
      paint();
    });
  });

  // JavaScript takes over from the #menu link
  menu.classList.add("js");
  if (location.hash === "#menu") show();
</script>

<style>
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: clamp(14px, 2vw, 28px);
  }

  .brand {
    text-decoration: none;
    padding: 0.25em 0.5em;
    margin-left: -0.5em;
    background: var(--paper);
    color: var(--ink);
  }

  /* The icon: four bars in a square. Lying flat they read as a menu; standing up they preview the four panels. */
  .menu-btn {
    --s: clamp(22px, 1.9vw, 30px);
    position: relative;
    z-index: 60;
    display: block;
    width: var(--s);
    height: var(--s);
    margin-left: auto;
    color: var(--paper);
    outline-offset: 6px;
  }

  .menu-btn i {
    position: absolute;
    left: 0;
    width: 100%;
    height: calc(var(--s) * 4 / 22);
    background: currentColor;
    transition-property: left, top, width, height;
    transition-duration: 0.36s;
    transition-timing-function: var(--spring);
  }

  .menu-btn i:nth-child(1) { top: 0; }
  .menu-btn i:nth-child(2) { top: calc(var(--s) * 6 / 22); }
  .menu-btn i:nth-child(3) { top: calc(var(--s) * 12 / 22); }
  .menu-btn i:nth-child(4) { top: calc(var(--s) * 18 / 22); }

  /* While the menu is open the bars are the panels; the icon itself is gone. Esc or the background closes it. */
  .menu-btn.gone { visibility: hidden; }

  .menu-btn.up i {
    top: 0;
    width: calc(var(--s) * 4 / 22);
    height: 100%;
  }

  .menu-btn.up i:nth-child(2) { left: calc(var(--s) * 6 / 22); }
  .menu-btn.up i:nth-child(3) { left: calc(var(--s) * 12 / 22); }
  .menu-btn.up i:nth-child(4) { left: calc(var(--s) * 18 / 22); }

  /* The menu screen */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: none;
    align-items: center;
    justify-content: center;
    background: var(--ink);
  }

  .menu:target,
  .menu.is-open { display: flex; }
  .menu.js:target:not(.is-open) { display: none; }

  /* While the cells run, the page underneath shows through them */
  .menu.covering { background: transparent; }
  .menu.covering:not(.flying, .clearing) .panels { visibility: hidden; }

  .cells {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .panels {
    position: relative;
    display: flex;
    gap: clamp(10px, 2.2vw, 36px);
    list-style: none;
  }

  /* One panel per section: tall, white, the name set sideways in the display face, reading upward */
  .panel {
    --wash: var(--dur) var(--spring);
    /* The hover frame. A hollow frame on blue reads smaller and lighter than the solid white panels beside it, so
       it is drawn heavier than a rule to hold the same mass. */
    --edge: clamp(3px, 0.32vw, 5px);
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    --pw: clamp(64px, 14vw, 220px);
    width: var(--pw);
    height: min(66svh, 600px);
    padding: clamp(10px, 1.4vw, 22px);
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    transform-origin: 0 0;
