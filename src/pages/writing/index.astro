---
import Ledger from "../../components/Ledger.astro";
import PageHead from "../../components/PageHead.astro";
import Base from "../../layouts/Base.astro";
import { getLedger, pad } from "../../lib/entries";

const entries = (await getLedger()).filter((e) => e.kind !== "project");
---

<Base title="Writing" theme="writing" description="Research and notes by Mykey Nishikawa.">
  <PageHead title="Writing" note={`${pad(entries.length)} ${entries.length === 1 ? "piece" : "pieces"}`} />
  <Ledger entries={entries} label="Writing" filters={["research", "note"]} />
</Base>
