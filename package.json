{
  "name": "myky",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler types && bun --bun astro dev",
    "build": "wrangler types && bun --bun astro build",
    "preview": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "check": "wrangler types && bun --bun astro check",
    "db:init": "wrangler d1 execute myky --local --file=schema.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.3",
    "@astrojs/mdx": "^8.1.2",
    "astro": "^7.4.4",
    "wrangler": "^4.156.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "22",
    "typescript": "^6"
  }
}
